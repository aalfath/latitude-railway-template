<clickhouse>
    <!-- Listen on IPv6 and IPv4 (Railway's private network is IPv6; Docker's is IPv4). -->
    <listen_host>::</listen_host>
    <listen_host>0.0.0.0</listen_host>
    <listen_try>1</listen_try>
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>
    <!-- Keep ClickHouse's own system logs small so they don't fill the volume. -->
    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <latency_log remove="1"/>
    <query_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <error_log remove="1"/>
</clickhouse>
